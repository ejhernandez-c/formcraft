# Copy to .env and fill in real values for local development.
# Never commit the real .env file.

# --- Database ---
POSTGRES_USER=formcraft
POSTGRES_PASSWORD=formcraft_local_password
POSTGRES_DB=formcraft
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://formcraft:formcraft_local_password@db:5432/formcraft

# --- Backend ---
BACKEND_PORT=8000
ENVIRONMENT=local
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Auth (Cognito) ---
# Leave all three blank for local development: the backend falls back to a
# local-only dev-login stand-in (app/core/security.py, POST /api/auth/dev-login)
# so Phase 2+ is fully testable without a provisioned Cognito user pool. Fill
# these in for development/staging/production — the app refuses to start in
# any non-local environment without them (see app/main.py).
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=
# Optional override for the local dev-login token signing secret — only read
# when the three variables above are blank. A safe default is baked in for
# local dev; set this explicitly only if you have a reason to.
# LOCAL_AUTH_SECRET=

VITE_AUTH_MODE=local
